// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GroupRole {
  OWNER
  MEMBER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  password     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  refreshToken String?  @unique

  groupsCreated    Group[]        @relation("GroupCreator")
  groupMemberships GroupMember[]
  expensesPaid     Expense[]
  expenseSplits    ExpenseSplit[]

  @@map("users")
}

model Group {
  id          String  @id @default(cuid())
  name        String
  description String?
  joinCode    String? @unique

  createdById String
  createdBy   User   @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Restrict)

  expenses  Expense[]
  members   GroupMember[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Lifecycle: active by default; archived groups keep all historical
  // records (memberships, expenses, splits) and are read-only until
  // restored. archivedAt records when the archive happened.
  isArchived Boolean   @default(false)
  archivedAt DateTime?

  @@index([createdById])
  @@map("groups")
}

model GroupMember {
  id       String    @id @default(cuid())
  userId   String
  groupId  String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
  @@map("group_members")
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Decimal  @db.Decimal(12, 2)
  paidById    String
  groupId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  paidBy User @relation(fields: [paidById], references: [id], onDelete: Restrict)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  splits ExpenseSplit[]

  @@index([groupId, createdAt])
  @@index([paidById])
  @@map("expenses")
}

model ExpenseSplit {
  id        String  @id @default(cuid())
  expenseId String
  userId    String
  amount    Decimal @db.Decimal(12, 2)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([expenseId, userId])
  @@index([userId])
  @@map("expense_splits")
}
