{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    "rootDir": "src",
    "outDir": "dist",

    "strict": true,
    "skipLibCheck": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "ignoreDeprecations": "5.0"
  },
  "include": ["src"]
}
